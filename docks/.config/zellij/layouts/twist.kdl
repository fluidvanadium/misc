layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
        pane //command="zellij"
    }
    tab_template name="cus" {
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
        children
    }
    cus name="tool" cwd="~" {
        pane command="zellij" {
			args "-n" "BRICK"
		}
    }
    cus name="show" cwd="leaves/museum_plan/audience_public/og_data" {
        pane command="zellij" {
			args "-n" "trifold"
		}
    }
}
keybinds {
    normal clear-defaults=true {
        bind "Ctrl q" { SwitchToMode "Tab"; }
    }
    tab {
        unbind "Ctrl t"
        unbind "Ctrl q"
        bind "Enter" { SwitchToMode "Normal"; }
        bind "p" { SwitchToMode "Pane"; }
    }
}
