layout {
    default_tab_template {
        // the default zellij tab-bar and status bar plugins
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
        children
    }

    tab name="abalone" split_direction="vertical" {
        pane {
			command "hx"
			args "abalone.txt"
            size "77%"
		}
    }
    tab name="ambitions" split_direction="vertical" cwd="ambitions" {
        pane {
            size "77%"
		}
    }
    tab name="todo_open" split_direction="vertical" {
        pane {
			command "hx"
			args "todo_open.txt"
            size "77%"
		}
    }
    tab name="tempender" split_direction="vertical" {
        pane {
			command "hx"
			args "tempender.txt"
            size "77%"
		}
    }
    tab name="manifest" split_direction="vertical" {
        pane {
			command "hx"
			args "loadout_plus.txt"
            size "77%"
		}
    }
    tab name="medicalendar" split_direction="vertical" {
        pane {
			command "hx"
			args "medicalendar.txt"
            size "77%"
		}
    }
    tab name="food_and_sleep" split_direction="vertical" {
        pane {
			command "hx"
			args "food_sleep.txt"
            size "77%"
		}
    }
}
