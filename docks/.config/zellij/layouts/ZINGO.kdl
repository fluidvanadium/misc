layout {
	tab_template name="wj" {
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
		pane split_direction="vertical" {
			pane size="50%" cwd="repo-worktrees/zingolibs/stable" command="cargo" {
				args "run" "--" "--data-dir=/home/cupress/ZINGO/my_wallets/treasury/"
			}
			pane size="50%" split_direction="horizontal" {
				pane command="hx" {
					args "wj/awareness_checklist.txt"
				}
				pane command="hx" {
					args "wj/notes.txt"
				}
			}
		}
	}
    wj name="wj"
	tab_template name="repos" {
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
		pane split_direction="horizontal" {
			pane size="50%" split_direction="vertical" {
				pane cwd="repo-worktrees/zingolib" {
				}
				pane cwd="repo-worktrees/zingolib" {
				}
				pane cwd="repo-worktrees/zingolib" {
				}
			}
			pane size="50%" split_direction="vertical" {
				pane cwd="repo-worktrees" {
				}
				pane cwd="repo-worktrees/" {
				}
				pane cwd="repo-worktrees/" {
				}
			}
		}
	}
    repos name="repos"
    default_tab_template split_direction="horizontal" {
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
		pane split_direction="vertical" {
			pane size="40%"
			pane size="40%"
			pane size="20%"
		}
    }
}
