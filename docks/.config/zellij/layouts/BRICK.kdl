layout {
    default_tab_template {
        // the default zellij tab-bar and status bar plugins
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
        children
    }
    tab name="root" {
        pane {
            command "sudo"
            args "su"
        }
    }
    tab name="backup" cwd="~" {
        pane {
            command "sudo"
            args "./backup.sh"
        }
    }
    tab name="BRICK" focus=true {
        pane {
            command "hx"
            args "~/brick"
        }
    }
    tab name="comms" cwd="~" {
        pane {
            command "brave"
            start_suspended true
        }
        pane {
            command "signal-desktop"
            start_suspended true
        }
    }
}
